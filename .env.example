# Copy to .env and fill in. Never commit the real .env.

ANTHROPIC_API_KEY=

# Spending cap for one invocation, in USD (default 30). Past it the run stops at a checkpoint and
# `--resume --approve` continues with a fresh cap.
BAT_MAX_RUN_USD=

# Where analyses live — one folder (and local git repo) per analysis, never inside this repo.
# Default: an "Analyses" folder two levels up from this repo (e.g. C:\DEV\Repos\Analyses).
BAT_ANALYSES_ROOT=

# Model and effort per role. Defaults live in src/agents/models.ts.
BAT_MODEL_BUSINESS_ANALYST=
BAT_MODEL_QUALITY_CONTROLLER=
BAT_MODEL_LESSONS_CURATOR=
# low | medium | high | xhigh | max
BAT_EFFORT_BUSINESS_ANALYST=
BAT_EFFORT_QUALITY_CONTROLLER=
BAT_EFFORT_LESSONS_CURATOR=
