# Copy to .env and fill in. Never commit the real .env.

# How the agents sign in to Claude — one of:
#   - leave this empty if Claude Code is installed and signed in on this machine (run `claude` once, then /login);
#   - or set an Anthropic API key from https://console.anthropic.com (usage is billed to that account).
# `npm run doctor` checks which one works.
ANTHROPIC_API_KEY=

# Spending cap for one invocation, in USD (default 30). Past it the run stops at a checkpoint and
# `--resume --approve` continues with a fresh cap.
BAT_MAX_RUN_USD=

# Where analyses are saved — one folder (and local git repo) per analysis.
# Default: the analyses/ folder inside this repo (gitignored).
BAT_ANALYSES_ROOT=

# Model and effort per role. Defaults live in src/agents/models.ts.
BAT_MODEL_BUSINESS_ANALYST=
BAT_MODEL_QUALITY_CONTROLLER=
BAT_MODEL_LESSONS_CURATOR=
# low | medium | high | xhigh | max
BAT_EFFORT_BUSINESS_ANALYST=
BAT_EFFORT_QUALITY_CONTROLLER=
BAT_EFFORT_LESSONS_CURATOR=
